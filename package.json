{
  "name": "cosmos-dev",
  "version": "1.0.0",
  "description": "Unified startup scripts for frontend and backend",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "cd apps/api && npm run dev",
    "dev:web": "cd apps/web && npx serve ."
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
